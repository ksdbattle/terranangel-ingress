# Terranangel Ingress —— 流量入口（边缘反代）
# 职责：把 terranangel.com 上的请求按路径分发到后端的各个 Render 服务。
# 注意：TLS 由 Render 边缘终止，容器内只需跑明文 HTTP，所以这里不配 ssl_certificate。

# WebSocket / SSE 透传所需（配合下面的 Upgrade / Connection 头）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # 必须监听 Render 注入的 $PORT，不能写 80
    listen ${PORT};
    server_name _;

    # ---------------------------------------------------------------
    # 运行时 DNS 解析
    #
    # resolver 必须写在 server / http 层，不能只写在 location 里。
    # 只有配合下面的「变量形式 proxy_pass」才有意义：
    #   写死 proxy_pass https://host;  -> 启动时解析一次，IP 永久缓存
    #   变量 proxy_pass https://$h;    -> 每个请求解析，按 valid 过期
    # 上游服务销毁重建、边缘 IP 变更后，写死形式会一直连旧 IP（查不到原因
    # 的 connect timeout / 502），只能重启 nginx；变量形式 30 秒内自愈。
    # ---------------------------------------------------------------
    resolver 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    resolver_timeout 5s;

    # 前端上游主机名（供 location / 使用）
    set $frontend_host terranangel-frontend.onrender.com;

    # ---------------------------------------------------------------
    # 探针：不依赖任何上游，专门用来判断「nginx 本身是否活着」
    #   GET /healthz -> ingress-ok  ：nginx 正常，问题在上游（前端 Static Site）
    #   GET /healthz -> 429 / 502   ：问题在 nginx 之前（实例休眠限流 / 容器没起来）
    # 精确匹配（=）优先级最高，不会被 location / 抢走。
    # ---------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ingress-ok\n";
    }

    # ---------------------------------------------------------------
    # 前端：透明反向代理到 Render Static Site
    #
    # 这里用 proxy_pass 而不是 return 302/301：
    # 跳转会把浏览器地址栏甩到 xxx.onrender.com，等于换了个源，
    # 跨域问题原样保留；反代则全程停在 terranangel.com，天然同源。
    #
    # proxy_pass 用变量形式（配合上面的 resolver）以便运行时重新解析。
    # 注意：变量后面不能跟 "/"，否则原始请求 URI 会被整个替换掉；
    # 不跟路径时 nginx 原样透传客户端请求 URI，与写死主机名的行为一致。
    # ---------------------------------------------------------------
    location / {
        proxy_pass https://$frontend_host;

        # Render 靠 SNI + Host 决定路由到哪个站点，这两个不设会 404 或证书报错
        # 用变量后 Host 也必须显式给，nginx 不会自动用变量里的主机名
        proxy_ssl_server_name on;
        proxy_set_header Host $frontend_host;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Render 免费实例 15 分钟无流量会休眠，冷启动约 1 分钟，
        # 超时给太小会直接抛 504 而不是「慢慢转出来」
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # -----------------------------------------------------------
        # 冷启动兜底：把上游的 502/503 换成「正在唤醒」页 + 自动刷新
        #
        # 为什么需要：nginx 转发出去的请求确实能唤醒上游，但 Render 在实例
        # 启动期间会【立刻】回 502/503（不是挂住等 60 秒），所以只加超时没用，
        # 用户看到的就是错误页。proxy_intercept_errors on 让 nginx 拦下这个
        # 502，改用自己的页面，页面每 3 秒自刷新，等上游热了自然就进去了。
        #
        # 504 也一并拦截：上游真挂住时会先撞 proxy_read_timeout 再变 504。
        # -----------------------------------------------------------
        proxy_intercept_errors on;
        error_page 502 503 504 = @waking_up;
    }

    # 「正在唤醒」占位页：纯 nginx return，不依赖任何上游，所以永远能出。
    # 用 meta refresh 而不是 JS，任何浏览器/爬虫都认，且不会被内容安全策略挡。
    #
    # 副作用（已知并接受）：上游如果是真的挂了、不是休眠，这个页面会一直循环刷新。
    # 区分办法：直接 curl 上游 https://terranangel-frontend.onrender.com/，
    # 若持续 3 分钟以上仍是 502，那就是真故障而非冷启动。
    location @waking_up {
        default_type text/html;
        # 别让浏览器/CDN 缓存这个中间态，否则唤醒完成后还停在占位页
        add_header Cache-Control "no-store" always;
        return 200 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="3"><title>Starting up</title><style>html,body{height:100%;margin:0}body{display:flex;align-items:center;justify-content:center;background:#0f1115;color:#e8e8ea;font:16px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;text-align:center;padding:24px}main{max-width:420px}h1{margin:0 0 10px;font-size:20px;font-weight:600}p{margin:0;opacity:.65;font-size:14px}</style></head><body><main><h1>Waking up the service</h1><p>The server was idle and is starting again. This page refreshes automatically, no action needed.</p></main></body></html>';
    }

    # ---------------------------------------------------------------
    # 后端 API（等 Java 业务网关部署好之后启用）
    #
    # 形如 /api/<服务名>/xxx  ->  https://<服务名>.onrender.com/xxx
    # 例如 /api/terranangel-gateway/user/info
    #      -> https://terranangel-gateway.onrender.com/user/info
    #
    # 【注意】用变量做 proxy_pass 时必须配 resolver：nginx 不会在启动时解析，
    # 而是运行时解析，缺 resolver 会报 "no resolver defined to resolve ..."。
    # resolver 已经在 server 层声明过（见文件开头），这里不用再写一遍。
    # 启用时把下面整段取消注释即可。
    # ---------------------------------------------------------------
    # location ~ ^/api/(?<svc>[a-zA-Z0-9-]+)/(?<rest>.*)$ {
    #     proxy_pass https://$svc.onrender.com/$rest$is_args$args;
    #
    #     proxy_ssl_server_name on;
    #     proxy_set_header Host $svc.onrender.com;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #
    #     proxy_connect_timeout 15s;
    #     proxy_read_timeout 120s;
    #     proxy_send_timeout 120s;
    # }
}
